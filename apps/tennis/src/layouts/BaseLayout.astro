---
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Tennis Butler',
  description = 'Find open tennis court bookings near Drummoyne in one search.',
} = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header style="border-bottom: 0.5px solid var(--border-default);">
      <div style="max-width: 720px; margin: 0 auto; padding: 20px 20px 16px; display: flex; align-items: baseline; justify-content: space-between; gap: 12px;">
        <a href="/" style="font-family: var(--font-heading); font-weight: 700; font-size: 20px; color: var(--text-primary); letter-spacing: -0.02em;">
          🎾 Tennis Butler
        </a>
        <a href="https://sanzh.ar/apps" style="font-size: 13px; color: var(--text-tertiary);">a sanzh.ar app</a>
      </div>
    </header>
    <main style="max-width: 720px; margin: 0 auto; padding: 24px 20px 64px;">
      <slot />
    </main>
  </body>
</html>
